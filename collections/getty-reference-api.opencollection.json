{
  "opencollection": "1.0.0",
  "info": {
    "name": "Getty Images Downloads Reference API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Api-Key",
      "value": "{{Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reference",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List available countries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.gettyimages.com/v3/countries"
          },
          "docs": "List available countries"
        }
      ]
    }
  ],
  "bundled": true
}